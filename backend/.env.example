# 简账 SimpleLedger 环境变量配置示例
# 复制为 .env 并填入真实值，切勿将 .env 提交到 Git

# 应用环境：development / production
APP_ENV=development

# Session 加密密钥，生产环境务必使用随机长字符串
SECRET_KEY=replace-with-a-random-secret-at-least-32-chars

# 数据库连接（MySQL 8，建议先创建 utf8mb4 数据库）
DATABASE_URL=mysql+pymysql://your_user:your_password@127.0.0.1:3306/simple_ledger?charset=utf8mb4

# 允许登录的邮箱域名（逗号分隔）
ALLOWED_EMAIL_DOMAINS=qq.com

# 允许携带 Session Cookie 的前端来源（逗号分隔）
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 验证码规则
CODE_EXPIRE_MINUTES=5
CODE_SEND_INTERVAL_SECONDS=60
CODE_MAX_ATTEMPTS=5
CODE_SEND_MAX_PER_HOUR=5

# QQ 邮箱 SMTP 配置
MAIL_HOST=smtp.qq.com
MAIL_PORT=465
MAIL_USERNAME=your_account@qq.com
MAIL_PASSWORD=qq_mail_authorization_code
MAIL_FROM=your_account@qq.com
MAIL_USE_TLS=true

# 开发模式：true 时验证码打印到日志，不真实发送邮件
MAIL_DEV_MODE=true

# Session Cookie：生产环境必须通过 HTTPS
# 不设置时由 APP_ENV 自动决定，production 默认为 true
# SESSION_HTTPS_ONLY=true
SESSION_MAX_AGE_SECONDS=1209600

# 文件上传大小上限（默认 10MB）
MAX_UPLOAD_SIZE_BYTES=10485760

# 分页
PAGE_SIZE=20

# 初始管理员：首次启动时自动创建或补齐管理员权限
ADMIN_EMAIL=admin@qq.com
ADMIN_PASSWORD=replace-with-a-strong-admin-password
